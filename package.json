    "user:create-admin": "tsx --conditions=react-server --env-file=.env.local scripts/create-admin.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@neondatabase/serverless": "^1.2.0",
    "better-auth": "^1.7.7",
