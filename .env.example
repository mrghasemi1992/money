# Copy to .env.local, or better: link the Vercel project and run `vercel env pull .env.local`.
# Never commit real values.

# Neon Postgres, added by the Vercel Neon integration (prefix "DATABASE").
# Pooled connection string, used by the app (Drizzle over Neon's HTTP driver).
DATABASE_URL="postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection string, used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Better Auth. Signs and encrypts sessions and tokens; at least 32 random characters.
# Generate one with: openssl rand -base64 32 (use a different value in Production).
# It is also the setup code that creates the first admin on /setup while there are no users.
BETTER_AUTH_SECRET=""
# The app's URL. Local: http://money.localhost:3000.
# Optional on Vercel: without it, Production uses the project's production domain
# (VERCEL_PROJECT_PRODUCTION_URL) and a Preview its own Vercel URLs.
BETTER_AUTH_URL="http://money.localhost:3000"
